#!/bin/sh

# Replace the placeholder admin passwords the image ships with. This runs
# before haproxy starts, so the haproxy.cfg edit needs no reload.
#
# A failing oneshot is fatal to gopherd, and that is wanted here: when sed
# cannot write (a read-only root or bind mount), the container must stop
# rather than serve the Data Plane API with the well-known placeholder.
set -e

DP_CONF="/usr/local/etc/haproxy/dataplaneapi.yml"
HAP_CONF="/usr/local/etc/haproxy/haproxy.cfg"

genpass() {
    tr -cd 'A-Za-z0-9!?%=' < /dev/urandom | head -c16
}

if grep -q "password: admin" "${DP_CONF}"; then
    PASS=$(genpass)
    # Quoted: a leading ! is a YAML tag and a leading % is invalid YAML.
    sed -i "s,password: admin,password: '${PASS}',g" "${DP_CONF}"
    echo "Generated admin password for Dataplaneapi"
fi

if grep -q "user admin insecure-password admin" "${HAP_CONF}"; then
    PASS=$(genpass)
    sed -i "s,user admin insecure-password admin,user admin insecure-password ${PASS},g" "${HAP_CONF}"
    echo "Generated admin password for Dataplaneapi"
fi
